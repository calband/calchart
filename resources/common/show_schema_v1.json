{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/calband/calchart/tree/main/schemas/show/v3.8/schema.json",
  "title": "CalChart Show (v3.8.x)",
  "description": "Schema for CalChart show files as produced by CalChart v3.8.x. Designed to be forward-compatible: additionalProperties is true throughout, so files written by a *newer* CalChart version that add new optional fields will still validate against this schema. Detecting and listing which specific fields a v3.8 reader does not understand is an application-level concern (diff actual object keys against this schema's declared 'properties'), not something JSON Schema validation reports on its own.",
  "type": "object",
  "$defs": {
    "symbolEnum": {
      "type": "string",
      "enum": [
        "Plain",
        "Sol",
        "Bksl",
        "Sl",
        "X",
        "Solbksl",
        "Solsl",
        "Solx"
      ],
      "description": "Known symbol set for v3.8.x. A future version that adds a new symbol would require bumping this schema (or loosening this enum) -- see notes."
    },
    "coordPair": {
      "type": "array",
      "description": "[x, y] in Coord::units. Accepts integer or floating-point numbers.",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "labelAndInstrument": {
      "type": "object",
      "description": "Marcher label and instrument.  If no instrument is supplied it will be default",
      "properties": {
        "label": {
          "type": "string"
        },
        "instrument": {
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": true
    },
    "fermataPair": {
      "type": "object",
      "properties": {
        "beat": {
          "type": "integer",
          "minimum": 0
        },
        "seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "showMode": {
      "type": "object",
      "properties": {
        "size": {
          "$ref": "#/$defs/coordPair"
        },
        "offset": {
          "$ref": "#/$defs/coordPair"
        },
        "border1": {
          "$ref": "#/$defs/coordPair"
        },
        "border2": {
          "$ref": "#/$defs/coordPair"
        },
        "hash_west": {
          "type": "integer"
        },
        "hash_east": {
          "type": "integer"
        },
        "yard_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "size",
        "offset",
        "border1",
        "border2",
        "hash_west",
        "hash_east",
        "yard_lines"
      ],
      "additionalProperties": true
    },
    "marcherPoint": {
      "type": "object",
      "properties": {
        "pos": {
          "$ref": "#/$defs/coordPair"
        },
        "ref": {
          "type": "array",
          "description": "Reference positions. Missing entries default to 'pos' at read time.",
          "items": {
            "$ref": "#/$defs/coordPair"
          }
        },
        "symbol": {
          "$ref": "#/$defs/symbolEnum"
        },
        "flip": {
          "type": "boolean",
          "description": "Flips display orientation.  If not supplied, is false."
        },
        "label_invisible": {
          "type": "boolean",
          "description": "control label invisible.  If not supplied, is false."
        }
      },
      "required": [
        "pos",
        "symbol"
      ],
      "additionalProperties": true
    },
    "valueNode": {
      "description": "A Value AST node (basic value, arithmetic op, variable, or function call).",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "ValueUnset"
            },
            "line": {
              "type": "integer",
